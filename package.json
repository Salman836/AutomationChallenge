{
  "name": "qa-challenge-trello-telenor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright + JavaScript automation for the Trello REST API workflow and the Telenor broadband E2E journey",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "playwright test --project=api --project=web-chromium",
    "test:api": "playwright test --project=api --ui",
    "test:api:smoke": "playwright test --project=api --grep @smoke",
    "test:web": "playwright test --project=web-chromium --ui",
    "test:web:all": "playwright test --project=web-chromium --project=web-firefox --project=web-webkit --project=web-mobile",
    "test:perf:api": "playwright test --project=perf-api --workers=1 --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.0",
    "dotenv": "^16.4.5"
  }
}
